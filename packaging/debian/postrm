#!/bin/sh
set -e

case "$1" in
    purge)
        rm -f /etc/unbound/unbound.conf.d/minidns.conf
        rm -rf /var/lib/minidns /var/log/minidns /etc/minidns
        if [ -d /run/systemd/system ] && systemctl is-active --quiet unbound 2>/dev/null; then
            systemctl reload unbound 2>/dev/null || systemctl restart unbound 2>/dev/null || true
        fi
        ;;
    remove)
        # keep config/state, but stop feeding a config that references our files
        rm -f /etc/unbound/unbound.conf.d/minidns.conf
        if [ -d /run/systemd/system ] && systemctl is-active --quiet unbound 2>/dev/null; then
            systemctl restart unbound 2>/dev/null || true
        fi
        ;;
esac

# give port 53 back to systemd-resolved if setup took it (see resolved.go)
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -f /etc/systemd/resolved.conf.d/minidns.conf ]; then
        rm -f /etc/systemd/resolved.conf.d/minidns.conf
        if [ "$(readlink /etc/resolv.conf 2>/dev/null)" = "/run/systemd/resolve/resolv.conf" ]; then
            ln -sfn ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
        fi
        if [ -d /run/systemd/system ]; then
            systemctl restart systemd-resolved 2>/dev/null || true
        fi
    fi
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi

exit 0
