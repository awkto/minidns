#!/bin/sh
set -e

mkdir -p /etc/minidns /var/lib/minidns/rpz /var/lib/minidns/zones /var/log/minidns
if getent passwd unbound >/dev/null 2>&1; then
    chown unbound:unbound /var/log/minidns
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi

echo ""
echo "minidns installed. Run:  sudo minidns setup"
echo ""

#DEBHELPER#
exit 0
